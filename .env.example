# Onshape API keys — names only, never commit real values.
#
# Create keys at https://dev-portal.onshape.com -> API keys.
#   * Read-only key  (scopes: Read)          -> used for reviews, renders, weight checks
#   * Read-write key (scopes: Read + Write)  -> used only for materials, features, Feature Studio pushes
#
# Recommended: set them as Windows user environment variables, NOT in a file.
# This folder is inside OneDrive, so any key file here gets uploaded to the cloud.
#
#   [Environment]::SetEnvironmentVariable("ONSHAPE_ACCESS_KEY", "...", "User")
#   [Environment]::SetEnvironmentVariable("ONSHAPE_SECRET_KEY", "...", "User")
#   [Environment]::SetEnvironmentVariable("ONSHAPE_RW_ACCESS_KEY", "...", "User")
#   [Environment]::SetEnvironmentVariable("ONSHAPE_RW_SECRET_KEY", "...", "User")
#
# Then fully restart the Claude app so it picks them up.
#
# Fallback (e.g. on a machine without OneDrive): copy this file to .env.local
# and fill in the values. The client reads .env.local only for variables that
# are not already set in the environment.

ONSHAPE_ACCESS_KEY=
ONSHAPE_SECRET_KEY=
ONSHAPE_RW_ACCESS_KEY=
ONSHAPE_RW_SECRET_KEY=
